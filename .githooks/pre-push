#!/bin/sh

echo "Running build before push..."
pnpm run build

if [ $? -ne 0 ]; then
    echo "Build failed. Push aborted."
    exit 1
fi

# Check if build produced any changes
if [ -n "$(git status --porcelain)" ]; then
    echo "Build produced changes, adding to last commit..."
    git add -A
    git commit --amend --no-edit
    echo "Changes amended to last commit."
fi

echo "Build successful. Proceeding with push."
